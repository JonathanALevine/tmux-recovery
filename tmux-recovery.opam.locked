opam-version: "2.0"
name: "tmux-recovery"
version: "dev"
synopsis: "Inspect, plan, and safely recover tmux workspaces"
description:
  "A native OCaml CLI and Bonsai_term TUI for conservative tmux workspace recovery."
maintainer: "Jonathan Levine"
authors: "Jonathan Levine"
license: "MIT"
homepage: "https://github.com/JonathanALevine/tmux-recovery"
bug-reports: "https://github.com/JonathanALevine/tmux-recovery/issues"
